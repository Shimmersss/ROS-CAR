<?xml version="1.0"?>
<package format="3">
  <name>gimbal_bridge</name><version>0.1.0</version>
  <description>Serial bridge, URDF and MCU simulator for the ROSCAR pan-tilt camera gimbal. No chassis commands.</description>
  <maintainer email="maintainer@example.invalid">ROSCAR maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>gimbal_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>tf2_ros_py</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
