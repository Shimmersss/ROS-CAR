  <description>Adapter from WheelTec Astra body messages to ROSCAR target state.</description>
  <maintainer email="maintainer@example.invalid">ROSCAR maintainers</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
