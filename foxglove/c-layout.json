{
  "configById": {
    "Image!detections": {
      "topic": "/perception/detections_preview/compressed",
      "imageMode": {
        "imageTopic": "/perception/detections_preview/compressed"
      },
      "foxglovePanelTitle": "画面：检测框 / 骨架 / 姿态 / LOCKED"
    },
    "RawMessages!target": {
      "topicPath": "/perception/target_state.detail",
      "foxglovePanelTitle": "目标说明（TRACKING 且有测距才会跟随）"
    },
    "Plot!distance": {
      "paths": [
        {
          "value": "/perception/target_state.horizontal_distance_m",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/perception/target_state.bearing_rad",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "foxglovePanelTitle": "目标距离 m / 偏角 rad（右为正）"
    },
    "RawMessages!guard": {
      "topicPath": "/control/state.data",
      "foxglovePanelTitle": "跟随保护：mode / reason / last_fault"
    },
    "Plot!cmd": {
      "paths": [
        {
          "value": "/cmd_vel.linear.x",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/cmd_vel.angular.z",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "isSynced": true,
      "foxglovePanelTitle": "最终速度 /cmd_vel：线速度 / 角速度"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "linkedGlobalVariables": [],
  "playbackConfig": {
    "speed": 1,
    "messageOrder": "receiveTime"
  },
  "layout": {
    "direction": "row",
    "first": "Image!detections",
    "second": {
      "direction": "column",
      "first": {
        "direction": "column",
        "first": "RawMessages!target",
        "second": "Plot!distance",
        "splitPercentage": 25
      },
      "second": {
        "direction": "column",
        "first": "RawMessages!guard",
        "second": "Plot!cmd",
        "splitPercentage": 30
      },
      "splitPercentage": 50
    },
    "splitPercentage": 62
  }
}
