    },
    "3D!radar": {
      "fixedFrame": "laser",
      "followTf": "laser",
      "topics": {
        "/scan": {"visible": true},
        "/radar/points": {"visible": false}
      },
      "foxglovePanelTitle": "N10P 扫描"
    },
    "RawMessages!radar": {
      "topicPath": "/radar/status",
      "defaultExpanded": true,
      "foxglovePanelTitle": "N10P 状态"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "linkedGlobalVariables": [],
  "playbackConfig": {"speed": 1, "messageOrder": "receiveTime"},
  "layout": {
    "direction": "row",
    "splitPercentage": 52,
    "first": {
      "direction": "column",
      "splitPercentage": 68,
      "first": "Image!detections",
      "second": {"direction": "row", "first": "RawMessages!target", "second": "Plot!distance"}
    },
    "second": {
      "direction": "column",
      "splitPercentage": 72,
