{
  "configById": {
    "Image!detections": {
      "topic": "/perception/detections_image",
      "imageMode": {"imageTopic": "/perception/detections_image"},
      "foxglovePanelTitle": "B 人体检测（320×240 / 10 FPS）"
    },
    "RawMessages!target": {
      "topicPath": "/perception/target_state",
      "defaultExpanded": true,
      "foxglovePanelTitle": "B 目标状态"
    },
    "Plot!distance": {
